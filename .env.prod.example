# Read by `docker compose -f docker-compose.prod.yml ...` when run from the
# repo root — copy this file to `.env` (same directory) and fill in real
# values. This is separate from apps/api/.env, which holds the API's own
# application secrets (JWT_*_SECRET, ATTACHMENT_URL_SECRET, SMTP_*, …) —
# copy apps/api/.env.example there too; both files are required.

# Generate each password with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Run it twice — POSTGRES_PASSWORD and REDIS_PASSWORD should differ.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Public domain this stack will be reachable at — its DNS A record must
# already point at this host before starting Caddy (see ./Caddyfile), or
# Let's Encrypt's HTTP-01 challenge fails and no certificate is issued.
DOMAIN=
# Used only for Let's Encrypt account registration/expiry notices — not
# publicly exposed.
ACME_EMAIL=
