# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.prod.example
!apps/api/.env.example

# uploaded attachments (local disk storage)
/apps/api/uploads/

# local pg_dump output from scripts/backup-db.sh
/apps/api/backups/
# same, for docker-compose.prod.yml's `backup` service
/backups/

# vercel
.vercel

# Claude Code's local permission allowlist — built up per-developer-machine
# from individual approval prompts, not something to share/merge across
# checkouts. .claude/launch.json (dev server config) stays tracked.
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# pdf.js worker — copied from node_modules by scripts/copy-pdf-worker.mjs
# (predev/prebuild), regenerated on every install rather than committed.
/public/pdf.worker.min.mjs
