generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ENGINEER
  COORDINATOR
  MANAGEMENT
  ADMIN
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationType {
  ASSIGNED
  STATUS_CHANGE
  OVERDUE
}

enum ImportJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum AnnotationKind {
  RECT
  ARROW
  FREEHAND
  TEXT
}

/**
 * Peran sebuah lampiran di dalam laporan "Tabel Clash Detection" — laporan
 * konsultan punya dua kolom gambar per baris (kondisi asli vs hasil clash
 * detection), dan tanpa penanda ini tidak ada cara memilih gambar mana yang
 * masuk kolom mana. OTHER adalah default supaya lampiran lama (dan setiap
 * upload yang penggunanya belum menandai) tidak diam-diam muncul di laporan:
 * lebih baik sel kosong daripada foto yang salah di dokumen yang dikirim ke
 * konsultan. Lihat ClashesService.report().
 */
enum AttachmentRole {
  ORIGINAL
  CLASH_DETECTION
  OTHER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  // Bumped on logout (and on password change — see AuthService.changePassword)
  // and used as the emergency "sign out everywhere" lever. Refresh JWTs
  // carry the version they were issued with; a mismatch means the token
  // predates the last logout/password-change and is rejected even though
  // its signature/exp are still valid. Day-to-day revocation of a single
  // session is handled by RefreshSession below instead — this counter is
  // for revoking every session at once.
  refreshTokenVersion Int      @default(0)
  // True for every account created by an Admin without an explicit
  // password, and set on the whole table by the migration that introduced
  // this column (every pre-existing account shared the `demo1234` default).
  // useRequireAuth() on the frontend redirects to /settings/password and
  // refuses to render anything else while this is true.
  mustChangePassword  Boolean   @default(false)
  passwordChangedAt   DateTime?
  // Counts consecutive failed login attempts; reset to 0 on a successful
  // login. Distinct from the per-IP throttle on POST /auth/login — this
  // bounds total attempts against ONE account regardless of how many
  // source IPs a distributed attacker spreads across.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectMemberships      ProjectMember[]
  reportedClashes         Clash[]                  @relation("ClashReporter")
  assignedClashes         Clash[]                  @relation("ClashAssignee")
  uploadedAttachments     Attachment[]
  comments                Comment[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  importJobs              ImportJob[]
  annotations             Annotation[]
  refreshSessions         RefreshSession[]
}

/**
 * One row per refresh token ever issued, so a refresh can be rotated (old
 * token marked revoked, new one issued) and — critically — so a REUSE of an
 * already-rotated token can be detected: that pattern means the token was
 * stolen and used after the legitimate client had already moved on to its
 * replacement. See AuthService.refresh(). tokenHash is sha256(token), never
 * the raw token, so a leaked database dump doesn't hand out valid sessions.
 */
model RefreshSession {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model Project {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft archive (Admin only). Archived projects drop out of the switcher
  // and GET /projects, and ProjectContextGuard rejects the X-Project-Id
  // header for them (403 PROJECT_ARCHIVED). Distinct from hard delete
  // (ProjectsService.remove), which is only allowed once a project has zero
  // clashes — archiving is the reversible path for everything else.
  archivedAt DateTime?

  members     ProjectMember[]
  disciplines Discipline[]
  zones       Zone[]
  clashes     Clash[]
  importJobs  ImportJob[]

  // Index ini SUDAH ada di database sejak migrasi
  // 20260808120000_project_archive_and_clash_seq, tapi tidak ikut
  // dideklarasikan di sini. Akibatnya setiap `prisma migrate dev`
  // berikutnya mem-diff-nya sebagai index liar dan menyisipkan
  // `DROP INDEX "Project_archivedAt_idx"` ke migrasi yang sedang dibuat —
  // menghapus index yang justru dipakai project switcher dan GET /projects
  // (keduanya memfilter archivedAt IS NULL). Dideklarasikan di sini supaya
  // schema dan database kembali sinkron dan DROP itu berhenti muncul.
  @@index([archivedAt])
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String
  userId      String
  projectRole String
  joinedAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Discipline {
  id        String  @id @default(uuid())
  projectId String
  code      String
  name      String
  isActive  Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id])
  clashes Clash[]

  @@unique([projectId, code])
}

model Zone {
  id        String  @id @default(uuid())
  projectId String
  name      String
  level     String
  isActive  Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id])
  clashes Clash[]
}

model Status {
  id            String  @id @default(uuid())
  name          String
  sequence      Int
  isClosedState Boolean @default(false)

  clashes Clash[]
}

model Priority {
  id       String  @id @default(uuid())
  name     String
  weight   Int
  isActive Boolean @default(true)

  clashes Clash[]
}

// Two partial unique indexes exist in the database but CANNOT be expressed
// here — Prisma has no partial-index syntax: `Clash_uniqueCode_live_key`
// (uniqueCode) and `Clash_disciplineId_seq_live_key` (disciplineId, seq),
// both `WHERE "deletedAt" IS NULL`. Every `prisma migrate dev` will diff
// this schema against the shadow DB and try to emit `DROP INDEX` for both —
// delete those lines from the generated migration before applying it. See
// HANDOFF.md gotcha list.
model Clash {
  id           String    @id @default(uuid())
  uniqueCode   String
  // Per-discipline sequence number. The source of truth for uniqueCode,
  // which is purely derived: `${project.code}-${discipline.code}-${seq
  // padded to 4}` (see ClashesService/clash-code.ts formatClashCode). Never
  // parse uniqueCode to recover this — discipline codes have no charset
  // validation and can legally contain "-".
  seq          Int
  projectId    String
  title        String
  description  String
  disciplineId String
  zoneId       String
  statusId     String
  priorityId   String
  reporterId   String
  assigneeId   String?
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  closedAt     DateTime?
  // Set only for clashes created via /import/commit. Nullable + unique per
  // project so most rows (created through the normal UI) can leave it null
  // without colliding, while an imported row with a given external id can
  // never be created twice in the same project (see ImportProcessor).
  externalId   String?
  // Dua kolom teks bebas laporan "Tabel Clash Detection": usulan penyelesaian
  // dari pihak TATA dan jawaban konsultan. Nullable, bukan default "", supaya
  // "belum diisi" bisa dibedakan dari "sengaja dikosongkan" — sejalan dengan
  // dueDate/closedAt/externalId di atas. Kolom "Resolve Date" di laporan tidak
  // ditambahkan di sini: itu closedAt yang sudah ada.
  resolveProposed     String?
  resolveByConsultant String?
  // Soft delete (Admin only). Null = visible everywhere. A nullable
  // timestamp rather than an `isActive` boolean like Discipline/Zone/Priority:
  // those mean "retired from new selection, still visible in history" (a
  // deactivated discipline still renders in the Register's filter chips),
  // which is a different concept from "hidden everywhere". Unlike earlier
  // revisions of this schema, uniqueCode/seq ARE freed on delete: a
  // soft-deleted clash's code can be reused by a new clash in the same
  // discipline (gap-filling allocator, see clash-code.ts), so both are only
  // unique among deletedAt IS NULL rows. restore() checks whether the old
  // code/seq is still free and, if not, allocates a fresh one at the end of
  // the sequence and records the reassignment in AuditLog.
  deletedAt    DateTime?

  project    Project    @relation(fields: [projectId], references: [id])
  discipline Discipline @relation(fields: [disciplineId], references: [id])
  zone       Zone       @relation(fields: [zoneId], references: [id])
  status     Status     @relation(fields: [statusId], references: [id])
  priority   Priority   @relation(fields: [priorityId], references: [id])
  reporter   User       @relation("ClashReporter", fields: [reporterId], references: [id])
  assignee   User?      @relation("ClashAssignee", fields: [assigneeId], references: [id])

  attachments   Attachment[]
  comments      Comment[]
  auditLogs     AuditLog[]
  notifications Notification[]

  // Replaces a single 8-column composite index that only ever served queries
  // prefixed by projectId. These four match the Register's actual filter/sort
  // patterns (default list order, status chips, "my clashes", due-date sort).
  @@index([projectId, createdAt])
  @@index([projectId, statusId])
  @@index([projectId, assigneeId])
  @@index([projectId, dueDate])
  @@index([projectId, deletedAt, createdAt])
  @@index([uniqueCode])
  @@unique([projectId, externalId])
}

model Attachment {
  id           String   @id @default(uuid())
  clashId      String
  fileName     String
  fileUrl      String
  fileType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())
  // DEFAULT-nya bukan sekadar kenyamanan: itu yang membuat kolom ini aditif
  // murni, sehingga Prisma Client versi lama (yang tidak menyebut kolom ini
  // di INSERT-nya) tetap bisa menulis baris Attachment. Artinya kode bisa
  // di-rollback tanpa harus ikut menurunkan skema.
  role         AttachmentRole @default(OTHER)

  clash      Clash @relation(fields: [clashId], references: [id])
  uploadedBy User  @relation(fields: [uploadedById], references: [id])

  annotations Annotation[]

  @@index([clashId])
}

/**
 * Vector markup drawn over an attachment (image or PDF page) — never
 * touches the original file. Geometry is stored normalized to [0,1] of the
 * page's intrinsic box (see src/lib/annotations.ts on the frontend), so one
 * mapping is exact at any zoom/viewport size. Shared: every project member
 * sees every annotation; edit/delete is restricted to the author or
 * Coordinator/Admin (see AnnotationsService).
 */
model Annotation {
  id           String         @id @default(uuid())
  attachmentId String
  pageNumber   Int            @default(1) // always 1 for images
  authorId     String
  kind         AnnotationKind
  geometry     Json
  color        String         @default("#ef4444")
  strokeWidth  Float          @default(0.004) // fraction of page WIDTH
  text         String? // TEXT kind only
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  attachment Attachment @relation(fields: [attachmentId], references: [id])
  author     User       @relation(fields: [authorId], references: [id])

  @@index([attachmentId, pageNumber])
}

model Comment {
  id        String   @id @default(uuid())
  clashId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  clash  Clash @relation(fields: [clashId], references: [id])
  author User  @relation(fields: [authorId], references: [id])

  @@index([clashId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  clashId   String
  actorId   String
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  clash Clash @relation(fields: [clashId], references: [id])
  actor User  @relation(fields: [actorId], references: [id])

  @@index([clashId, createdAt])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  clashId   String
  channel   NotificationChannel
  type      NotificationType
  isSent    Boolean
  createdAt DateTime            @default(now())

  user  User  @relation(fields: [userId], references: [id])
  clash Clash @relation(fields: [clashId], references: [id])
}

model NotificationPreference {
  id              String  @id @default(uuid())
  userId          String  @unique
  emailEnabled    Boolean @default(true)
  whatsappEnabled Boolean @default(false)
  whatsappNumber  String  @default("")

  user User @relation(fields: [userId], references: [id])
}

// One row per /import/commit call. Rows/progress are updated by
// ImportProcessor as it works through the file so the frontend wizard can
// poll GET /import/jobs/:id for live progress instead of blocking on one
// long-lived HTTP request.
model ImportJob {
  id            String          @id @default(uuid())
  projectId     String
  createdById   String
  fileName      String
  storageKey    String
  format        String
  mapping       Json
  autoCreate    Boolean         @default(false)
  status        ImportJobStatus @default(QUEUED)
  totalRows     Int             @default(0)
  processedRows Int             @default(0)
  succeededRows Int             @default(0)
  failedRows    Int             @default(0)
  skippedRows   Int             @default(0)
  errors        Json            @default("[]")
  createdAt     DateTime        @default(now())
  finishedAt    DateTime?

  project   Project @relation(fields: [projectId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([projectId, createdAt])
}
