generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ENGINEER
  COORDINATOR
  MANAGEMENT
  ADMIN
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationType {
  ASSIGNED
  STATUS_CHANGE
  OVERDUE
}

enum ImportJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  // Bumped on logout (and could be on password change). Refresh JWTs carry
  // the version they were issued with; a mismatch means the token predates
  // the last logout and is rejected even though its signature/exp are still
  // valid — this is what makes logout actually invalidate stolen tokens
  // instead of merely clearing the browser's cookie.
  refreshTokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectMemberships      ProjectMember[]
  reportedClashes         Clash[]                  @relation("ClashReporter")
  assignedClashes         Clash[]                  @relation("ClashAssignee")
  uploadedAttachments     Attachment[]
  comments                Comment[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  importJobs              ImportJob[]
}

model Project {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     ProjectMember[]
  disciplines Discipline[]
  zones       Zone[]
  clashes     Clash[]
  importJobs  ImportJob[]
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String
  userId      String
  projectRole String
  joinedAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Discipline {
  id        String  @id @default(uuid())
  projectId String
  code      String
  name      String
  isActive  Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id])
  clashes Clash[]

  @@unique([projectId, code])
}

model Zone {
  id        String  @id @default(uuid())
  projectId String
  name      String
  level     String
  isActive  Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id])
  clashes Clash[]
}

model Status {
  id            String  @id @default(uuid())
  name          String
  sequence      Int
  isClosedState Boolean @default(false)

  clashes Clash[]
}

model Priority {
  id       String  @id @default(uuid())
  name     String
  weight   Int
  isActive Boolean @default(true)

  clashes Clash[]
}

model Clash {
  id           String    @id @default(uuid())
  uniqueCode   String    @unique
  projectId    String
  title        String
  description  String
  disciplineId String
  zoneId       String
  statusId     String
  priorityId   String
  reporterId   String
  assigneeId   String?
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  closedAt     DateTime?
  // Set only for clashes created via /import/commit. Nullable + unique per
  // project so most rows (created through the normal UI) can leave it null
  // without colliding, while an imported row with a given external id can
  // never be created twice in the same project (see ImportProcessor).
  externalId   String?

  project    Project    @relation(fields: [projectId], references: [id])
  discipline Discipline @relation(fields: [disciplineId], references: [id])
  zone       Zone       @relation(fields: [zoneId], references: [id])
  status     Status     @relation(fields: [statusId], references: [id])
  priority   Priority   @relation(fields: [priorityId], references: [id])
  reporter   User       @relation("ClashReporter", fields: [reporterId], references: [id])
  assignee   User?      @relation("ClashAssignee", fields: [assigneeId], references: [id])

  attachments   Attachment[]
  comments      Comment[]
  auditLogs     AuditLog[]
  notifications Notification[]

  // Replaces a single 8-column composite index that only ever served queries
  // prefixed by projectId. These four match the Register's actual filter/sort
  // patterns (default list order, status chips, "my clashes", due-date sort).
  @@index([projectId, createdAt])
  @@index([projectId, statusId])
  @@index([projectId, assigneeId])
  @@index([projectId, dueDate])
  @@unique([projectId, externalId])
}

model Attachment {
  id           String   @id @default(uuid())
  clashId      String
  fileName     String
  fileUrl      String
  fileType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())

  clash      Clash @relation(fields: [clashId], references: [id])
  uploadedBy User  @relation(fields: [uploadedById], references: [id])
}

model Comment {
  id        String   @id @default(uuid())
  clashId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  clash  Clash @relation(fields: [clashId], references: [id])
  author User  @relation(fields: [authorId], references: [id])

  @@index([clashId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  clashId   String
  actorId   String
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  clash Clash @relation(fields: [clashId], references: [id])
  actor User  @relation(fields: [actorId], references: [id])

  @@index([clashId, createdAt])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  clashId   String
  channel   NotificationChannel
  type      NotificationType
  isSent    Boolean
  createdAt DateTime            @default(now())

  user  User  @relation(fields: [userId], references: [id])
  clash Clash @relation(fields: [clashId], references: [id])
}

model NotificationPreference {
  id              String  @id @default(uuid())
  userId          String  @unique
  emailEnabled    Boolean @default(true)
  whatsappEnabled Boolean @default(false)
  whatsappNumber  String  @default("")

  user User @relation(fields: [userId], references: [id])
}

// One row per /import/commit call. Rows/progress are updated by
// ImportProcessor as it works through the file so the frontend wizard can
// poll GET /import/jobs/:id for live progress instead of blocking on one
// long-lived HTTP request.
model ImportJob {
  id            String          @id @default(uuid())
  projectId     String
  createdById   String
  fileName      String
  storageKey    String
  format        String
  mapping       Json
  autoCreate    Boolean         @default(false)
  status        ImportJobStatus @default(QUEUED)
  totalRows     Int             @default(0)
  processedRows Int             @default(0)
  succeededRows Int             @default(0)
  failedRows    Int             @default(0)
  skippedRows   Int             @default(0)
  errors        Json            @default("[]")
  createdAt     DateTime        @default(now())
  finishedAt    DateTime?

  project   Project @relation(fields: [projectId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([projectId, createdAt])
}
