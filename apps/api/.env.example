PORT=3001

# How many reverse-proxy hops sit in front of this process — see
# env.validation.ts. 1 for a single proxy (Caddy/nginx); 2 once Cloudflare
# also sits in front of that. Leave at the default for local dev (no proxy).
TRUSTED_PROXY_HOPS=1

DATABASE_URL="postgresql://clashuser:clashpass@localhost:5432/clashhub_db?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
# Empty is fine for local dev (matches apps/api/docker-compose.yml's Redis,
# which has no --requirepass). Production's docker-compose.prod.yml sets one.
REDIS_PASSWORD=

# These two placeholders are deliberately rejected by env.validation.ts —
# copying this file as-is will fail to boot. Generate real ones with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Run it twice; JWT_ACCESS_SECRET and JWT_REFRESH_SECRET must differ.
JWT_ACCESS_SECRET="dev-access-secret-ganti-di-produksi"
JWT_REFRESH_SECRET="dev-refresh-secret-ganti-di-produksi"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

UPLOAD_DIR="./uploads"
# Multer's diskStorage staging directory — see storage.service.ts.
UPLOAD_TMP_DIR="./uploads/tmp"
# No default in env.validation.ts on purpose — see the comment there.
# Generate the same way as the JWT secrets above.
ATTACHMENT_URL_SECRET="dev-attachment-url-secret-ganti-di-produksi"

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="EPS Workspace <noreply@clashhub.dev>"
# Required only when NODE_ENV=production — MailHog (this default SMTP_HOST)
# needs no auth, but a real provider will.
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

WEB_BASE_URL="http://localhost:3000"

# Optional — error tracking is a no-op when this is unset/empty, no Sentry
# account needed to run the app. Set it in production to start reporting.
SENTRY_DSN=

# Kill switch fitur Export Laporan Clash (GET /clashes/report). Default true.
# Setel false lalu restart API untuk mematikan fitur dalam hitungan detik —
# tombolnya hilang dari Register dan endpoint-nya membalas 404. Tidak butuh
# rebuild frontend, tidak menyentuh database, tidak ada data yang hilang.
CLASH_REPORT_ENABLED=true
